# =============================================================================
# Director's Chair — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# =============================================================================

# Supabase — get these from your Supabase project dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # Server-only: used for storage uploads + DB inserts

# AI Provider — "mock" runs the app with pre-generated demo assets (no API keys needed)
#              "real" requires GEMINI_API_KEY and calls NB2 Lite + Omni Flash
AI_PROVIDER=mock
NEXT_PUBLIC_AI_PROVIDER=mock
GEMINI_API_KEY=                   # Only needed when AI_PROVIDER=real
NB2_MODEL_ID=gemini-3.1-flash-lite-image
OMNI_MODEL_ID=gemini-omni-flash-preview
